package wired:wds;

world all {
  import api;
  import types;
}

interface api {
  use types.{wds};
  get-wds: func() -> wds;
}

interface types {
  type did  = string;
  type hash = list<u8>;

  record wds-record {
    id:         hash,
    creator:    did,
    schemas:    list<hash>,
    containers: list<tuple<string, list<u8>>>,
  }

  record query-filter {
    creator: option<did>,
    schemas: option<list<hash>>,
  }

  resource query-future {
    poll: func() -> option<result<list<hash>>>;
  }

  resource read-future {
    poll: func() -> option<result<wds-record>>;
  }

  resource wds {
    query: func(filter: option<query-filter>) -> query-future;
    read:  func(record-id: hash) -> read-future;
  }
}
