package wired:kv;

world all {
  import api;
  import types;
}

interface api {
  use types.{kv, document-id};

  // KV store for the script's own host document.
  self-kv: func() -> kv;

  // KV store for any document visible in the current space.
  // Returns none if the doc is not present or allowed.
  get-kv: func(id: document-id) -> option<kv>;
}

interface types {
  type document-id = list<u8>;

  variant kv-error {
    quota-exceeded,
    key-too-long,
  }

  resource kv {
    get:    func(key: string) -> option<list<u8>>;
    set:    func(key: string, value: list<u8>) -> result<_, kv-error>;
    delete: func(key: string);
    keys:   func() -> list<string>;
  }
}
