package unavi:tool;

world guest {
  include wired:prelude/lib;
  export api;
}

/// A shell-hosted tool, built by a tool crate.
interface api {
  use wired:math/types.{transform};
  use wired:scene/types.{color, prim, prim-id};

  /// Visual state the shell pushes onto a tool.
  record tool-state {
    color:  color,
    in-use: bool,
  }

  variant tool-event {
    activate(transform),
    deactivate,
    set-state(tool-state),
    /// Primary action forwarded by the shell while its menu is down.
    trigger(bool),
    /// Signed scroll notches (+ in, - out).
    scroll(f32),
  }

  resource tool {
    /// `name` and `description` are shown by the shell; `icon` is a prim
    /// carrying a mesh, rendered as the tool's icon.
    constructor(name: string, description: string, icon: borrow<prim>);
    poll: func() -> option<tool-event>;
  }

  record registered-tool {
    doc-id:       list<u8>,
    name:         string,
    description:  string,
    icon-prim-id: prim-id,
  }

  /// Registry the shell pushes tools into, polled every frame.
  resource tool-registry {
    constructor();
    poll: func() -> list<registered-tool>;
    activate: func(doc-id: list<u8>, transform: transform);
    deactivate: func(doc-id: list<u8>);
    set-state: func(doc-id: list<u8>, state: tool-state);
    trigger: func(doc-id: list<u8>, pressed: bool);
    scroll: func(doc-id: list<u8>, delta: f32);
  }
}
