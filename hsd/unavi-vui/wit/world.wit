package unavi:vui;

world guest {
  include wired:prelude/imports;
  export api;
}

/// Spatial UI, drawn into the calling script's own document and driven from
/// its update loop.
interface api {
  use wired:core/error.{error};
  use wired:core/math.{color, transform, vec2, vec3};
  use wired:scene/document.{document, prim-id};

  /// What a mote is: how it draws, and what selecting it does.
  enum kind {
    /// Fires and is done — a pulse.
    action,
    /// Turns on, and off again when it is next chosen. Selecting one flips
    /// `active`, which it then holds and draws lit until something clears it.
    toggle,
    /// Can be pulled out and left in the room, or filed into a grid.
    /// Acting on one where it sits lands it there instead, so both buttons
    /// deliver the item and only the grip chooses where.
    item,
    /// Opens a cast site, which fills while it is held.
    cast,
    /// Opens into its children, where it stands. Carried out and let go, it
    /// opens around where it landed instead, at a height the viewer can
    /// read — the surface stays there until it is summoned back.
    group,
  }

  /// How a group's children are laid out when it opens. A grid and an orbit
  /// hold the same thing; this is the shape it takes, not a kind of mote.
  enum arrange {
    /// Around the parent, which stays in the middle.
    orbit,
    /// In rows, filling from the top left.
    grid,
    /// Nine keys in a three by three bed with a page standing above it.
    /// The root level puts its first child in the middle and the next four
    /// up, right, down and left of it, leaving the corners empty. A level
    /// inside it holds the way back in the middle and up to eight children
    /// around it, paging past that. The page shows the attended key, the
    /// last key pressed, or at the root the text from `orbit.set-resting`.
    bed,
  }

  /// A face made of dots, the way a dot-matrix display is: a square grid,
  /// each cell lit or not.
  ///
  /// Cells run in rows from the top left, left to right. Cell `i` is bit
  /// `i % 8` of `bits[i / 8]`, counting from the least significant bit, so the
  /// first cell is the low bit of the first byte and a nine-cell row spills one
  /// bit into the second.
  ///
  /// The grid is clipped to a circle: a cell whose centre lies more than
  /// `(size - 1) / 2 + 0.6` cells from the grid's centre is never drawn,
  /// whatever its bit says. That takes the corners off a square grid so the
  /// face reads as round, like the shell it sits in.
  record glyph {
    /// Cells along each side, from 1 to 13.
    size: u8,
    /// At least `ceil(size * size / 8)` bytes. Bytes past that are ignored.
    bits: list<u8>,
  }

  /// A mote, and the level of children under it.
  ///
  /// A handle stays good after the mote is mounted, so a level edited while
  /// it is up redraws. A mote is the child of one level at a time: adding it
  /// somewhere else moves it.
  resource mote {
    /// `label` is at most 256 bytes; over that is `invalid-argument`.
    constructor(kind: kind, label: string) -> result<mote, error>;

    /// Whether both handles name the same mote.
    is: func(other: borrow<mote>) -> bool;

    label: func() -> string;
    /// At most 256 bytes.
    set-label: func(value: string) -> result<_, error>;

    /// What it does, shown on its placard once attention has been held.
    description: func() -> option<string>;
    /// At most 1024 bytes.
    set-description: func(value: string) -> result<_, error>;

    /// Tells the viewer something about this mote: a short card on its body,
    /// shown for a few seconds whether or not the mote is attended, in place
    /// of its usual placard. Meant for what went wrong, so it is styled as a
    /// warning.
    ///
    /// Seen only while the mote is drawn: a notice for a mote that is not up
    /// runs out unseen. Only one notice shows at a time; if several motes
    /// have one, the first drawn wins. A notice posted before any surface
    /// exists is timed from the first `update`. At most 1024 bytes; anything
    /// past that is cut.
    notify: func(message: string);

    /// A number identifying this mote, stable for as long as some handle
    /// keeps it alive. Key a map by this instead of comparing every entry
    /// with `is`.
    id: func() -> u64;

    /// What this mote looks like, drawn inside its shell — a prim in `doc`,
    /// the same document the surface draws into.
    ///
    /// Author it to fit a unit sphere: the surface parents it and scales it
    /// to whatever the mote is drawn at, so it grows with attention like the
    /// shell around it. An item holding an icon draws see-through so the icon
    /// reads; an item without one is solid.
    set-icon: func(doc: borrow<document>, value: option<prim-id>);

    /// What this mote looks like as a grid of dots, drawn on its face instead
    /// of an icon. An icon the mote also holds is put away while it has a
    /// glyph, and comes back when the glyph is set to none.
    ///
    /// Lit dots wear the mote's colour and unlit ones stay faintly drawn, so
    /// the face reads as a display rather than a sticker. Setting a different
    /// glyph on a mote that is already drawn flips the dots over, a column at a
    /// time from the left; a mote that has only just appeared, or a glyph of a
    /// different size, simply shows.
    ///
    /// `invalid-argument` for a `size` outside 1 to 13, or for `bits` shorter
    /// than the grid needs. The previous glyph is kept when it is refused.
    set-glyph: func(value: option<glyph>) -> result<_, error>;

    /// The hue this mote's glass carries, or none for the neutral one.
    ///
    /// Identity, not state: what a mote *is*, not what is happening to it.
    /// The shell tints through rather than painting, so a tinted mote reads
    /// as coloured glass — colouring the icon inside too would make it busy.
    set-tint: func(value: option<color>);

    /// How much of the iridescent film the shell wears, `0` none to `1` the
    /// full bubble.
    ///
    /// Subtle by default so a mote keeps its identity hue while still reading
    /// as glass.
    set-film: func(value: f32);

    /// How much the shell's rim is frosted, `0` for clear glass.
    ///
    /// Diffuses what shows through the rim while the face stays a clear
    /// window, so the icon stays readable.
    set-frost: func(value: f32);

    /// Whether this item stands for the one of its thing or for a source of
    /// them. Only an item is either; anything else ignores it.
    ///
    /// A unique item is *that* thing: placing it again is the same thing
    /// moving. A source is inexhaustible: every placing is another of it.
    unique: func() -> bool;
    set-unique: func(value: bool);

    /// The shape this mote's own level takes when it opens. Groups default to
    /// an orbit; anything else ignores it.
    arrange: func() -> arrange;
    set-arrange: func(value: arrange);

    /// Whether a toggle is on. Anything else ignores it.
    ///
    /// Selecting a toggle flips this and reports `activated`.
    active: func() -> bool;
    set-active: func(value: bool);

    parent: func() -> option<mote>;
    children: func() -> list<mote>;

    /// Takes `child` from whatever it was under and puts it here. Refused,
    /// and false, when `child` is already an ancestor — the only way a level
    /// could come to contain itself.
    add-child: func(child: borrow<mote>) -> bool;
    /// Takes `child` out of this level, doing nothing if it was never in it.
    remove-child: func(child: borrow<mote>);
    clear: func();
  }

  /// Which way a surface is measured off the viewer when it is placed.
  enum bearing {
    /// Ahead on the ground plane, standing upright however the viewer was
    /// looking. A surface you walk up to, and one that never ends up
    /// underfoot or overhead.
    level,
    /// Along the line of sight, turned to face the viewer. A surface summoned
    /// to where the eye already is, rather than one the eye has to find.
    sight,
  }

  /// Where a surface stands, measured from the viewer at the moment it first
  /// draws. It stays there afterwards: a menu that follows you around is a
  /// menu you cannot walk up to.
  record mount {
    /// Metres ahead of the viewer, along whichever direction `bearing` names.
    distance: f32,
    /// Metres above the eye, usually negative so a surface sits below it.
    height: f32,
    /// Sideways and vertical shift in the mounted frame, so surfaces sharing
    /// one facing do not sit on top of each other.
    offset: vec2,
    bearing: bearing,
  }

  /// Where a carried mote was let go, in the frame a document's offset is
  /// measured in, so placing one here needs no conversion.
  record landing {
    at: vec3,
    /// What the mote was carrying when it was released, for a consumer that
    /// wants the throw to land in what it places.
    velocity: vec3,
  }

  record page {
    index: u32,
    /// Pages the level takes in all.
    pages: u32,
    /// Motes the level holds in all.
    motes: u32,
  }

  /// A mote let go in the room with nowhere of its own to go.
  record planted {
    mote: mote,
    landing: landing,
  }

  /// What a surface did, in the terms a consumer thinks in.
  variant event {
    /// A container opened; the level inside it is drawn now. A container
    /// carried out and let go opens the same way, and the surface stands
    /// where it landed rather than where it was.
    opened(mote),
    /// The way back was taken, to the level now open.
    closed(mote),
    /// A leaf fired. An item is not one: what it does is land, so it
    /// reports `planted` whichever button delivered it.
    activated(mote),
    /// A cast site opened. Nothing has fired: it fills while the grasp is
    /// held on the mote, and releasing early aborts.
    casting(mote),
    /// A cast was held to the end.
    cast(mote),
    /// A cast was abandoned before it filled.
    aborted(mote),
    /// Let go in the room by a mote with nowhere of its own to go: the
    /// surface draws nothing there. What lands, if anything, is the
    /// consumer's to place at the landing.
    planted(planted),
    /// Carried out and filed into a grid.
    filed(mote),
    /// The page turned.
    paged(page),
  }

  /// What the page above a bed says while no key is attended and none has
  /// been pressed.
  record resting {
    /// Set in the page's title strip. At most 256 bytes.
    title: string,
    /// One paragraph each, at most eight, 256 bytes apiece.
    lines: list<string>,
  }

  /// A level of motes arranged around an anchor, selected by direction.
  resource orbit {
    /// Puts one up over `root`, drawing `capacity` motes at once and paging
    /// anything past that. `capacity` is at most 64.
    new: static func(root: borrow<mote>, mount: mount, capacity: u32) -> result<orbit, error>;

    /// Everything this orbit did since the last call.
    events: func() -> list<event>;

    /// Shows `text` as a small dot-matrix display at the orbit's centre, or
    /// takes it down on none. Meant for a readout such as a clock.
    ///
    /// It is a face, not a mote: it is never selected, takes no attention and
    /// no press, and a pointer resting on the centre still selects nothing
    /// because of it. It shows only while the orbit's root level is open;
    /// while a nested level holds the centre with its way back, it is hidden,
    /// and comes back with the root. A text set in the meantime is kept.
    ///
    /// Up to two lines, split at a newline, set in a 3 by 5 dot font on a grid
    /// of 13 dots a side. The font has the digits, `:`, `-`, space and the
    /// letters A to Z, lower case reading as upper; any other character is
    /// drawn blank. With two lines each holds up to two characters, and a
    /// single line up to three; characters past that, and lines past the
    /// second, are dropped. Each line is centred. Changing the text flips the
    /// dots over from the left, the way a glyph does.
    ///
    /// `invalid-argument` for more than 64 bytes of text.
    set-readout: func(text: option<string>) -> result<_, error>;

    /// What the page above a bed shows at the root level while no key is
    /// attended and none has been pressed, or nothing on none. Levels inside
    /// the root have no resting page, and an orbit whose levels are not
    /// beds shows none.
    ///
    /// `invalid-argument` for a title or line over its limit, or more than
    /// eight lines. The previous page is kept when it is refused.
    set-resting: func(page: option<resting>) -> result<_, error>;

    /// Puts it up where the viewer is standing now. A surface measures its
    /// place once and keeps it, so this is how one comes to be somewhere
    /// else. Everything it draws is kept, so summoning again is cheap.
    summon: func() -> result<_, error>;
    /// Takes it down. Nothing it drew is thrown away, and its hit surface
    /// goes with it rather than staying as a wall you cannot see.
    dismiss: func() -> result<_, error>;
    /// Whether it is up.
    shown: func() -> bool;
    /// Whether a mote is in hand or a cast is filling. A consumer that
    /// dismisses the surface on its own terms leaves it up while this holds,
    /// since dismissing ends the grasp.
    held: func() -> bool;
  }

  /// A bounded grid of `root`'s motes, and a destination a release over it
  /// lands in: a mote filed here is taken out of the level it came from and
  /// hung under `root`.
  resource grid {
    /// `columns * rows` is at most 256.
    new: static func(
      root: borrow<mote>,
      columns: u32,
      rows: u32,
      mount: mount,
    ) -> result<grid, error>;

    events: func() -> list<event>;

    summon: func() -> result<_, error>;
    dismiss: func() -> result<_, error>;
    shown: func() -> bool;
    /// Whether a mote is in hand or a cast is filling.
    held: func() -> bool;
  }

  /// How a paragraph of a `text` block is set.
  enum tone {
    /// Plain ink.
    body,
    /// Ink at reduced contrast, still readable on the pane.
    muted,
    /// The warning colour.
    warning,
  }

  /// A paragraph of a `text` block.
  record span {
    /// At most 1024 bytes. Wraps to the pane, and `\n` starts a line.
    text: string,
    tone: tone,
    /// The id a press on the paragraph reports as `followed`.
    link: option<u32>,
  }

  /// A named, pressable button.
  record action-control {
    /// At most 1024 bytes.
    label: string,
    /// Drawn in the accent rather than neutral.
    primary: bool,
  }

  /// A number on a pane, changed by pressing it and dragging sideways.
  record number-control {
    value: f32,
    /// How much `value` changes per column of the pane the pointer travels
    /// across. Negative runs the other way.
    per-column: f32,
  }

  record choice-control {
    /// Each at most 1024 bytes. The options sit side by side.
    options: list<string>,
    /// The chosen option, drawn filled.
    selected: u32,
  }

  /// What a form row, a bar item or a table cell shows, and what pressing it
  /// does. The pane draws the value the consumer sets, never the one asked
  /// for.
  variant control {
    /// Text to read. Pressing does nothing.
    value(string),
    /// Pressing reports `pressed`.
    action(action-control),
    /// Two cells, the lit one showing the state. Pressing reports `toggled`
    /// with the other state.
    toggle(bool),
    /// A row of cells lit up to a fraction from 0 to 1. Pressing or dragging
    /// along it reports `slid`.
    slider(f32),
    /// The same row, to read. Pressing does nothing.
    meter(f32),
    /// Dragging sideways reports `scrubbed`, and letting go `released`.
    number(number-control),
    /// Pressing an option reports `chosen`.
    choice(choice-control),
    /// A destination's name, underlined. Pressing reports `followed`.
    link(string),
  }

  /// A row of a `form` block: a label at the left and one control at the
  /// right.
  record form-row {
    /// The consumer's own name for the control, which events report. Keep it
    /// stable across `set-blocks` so a drag in progress follows its row.
    id: u32,
    /// At most 1024 bytes.
    label: string,
    control: control,
  }

  record table-column {
    /// At most 1024 bytes.
    title: string,
    /// Width in columns of the pane.
    columns: u32,
  }

  /// A row of a `table` block. Pressing it reports `selected`.
  record table-row {
    id: u32,
    /// One per column; cells past the last column are not drawn. Each at
    /// most 1024 bytes.
    cells: list<string>,
    selected: bool,
  }

  record table {
    /// The column titles stay at the top while the rows scroll. None draws
    /// no header.
    columns: list<table-column>,
    rows: list<table-row>,
  }

  /// A row of a `tree` block. Pressing it reports `selected`, and pressing
  /// its fold mark reports `folded`.
  record tree-node {
    id: u32,
    /// At most 1024 bytes.
    label: string,
    /// Levels it is indented.
    depth: u32,
    /// Whether it is unfolded, or none for a leaf with no fold mark.
    open: option<bool>,
    selected: bool,
  }

  record bar-item {
    id: u32,
    control: control,
  }

  /// What a block shows. At most 512 rows, items, spans or nodes.
  variant block-kind {
    /// Prose, wrapped to the pane. Scrolls.
    text(list<span>),
    /// Rows of a label and one control. Scrolls.
    form(list<form-row>),
    /// Rows under named columns. Scrolls.
    table(table),
    /// Indented rows. The consumer sends the rows that are visible and sets
    /// what `folded` asks for. Scrolls.
    tree(list<tree-node>),
    /// One line of controls, left to right.
    bar(list<bar-item>),
  }

  /// How many lines a block takes.
  variant block-height {
    /// A fixed number, held to what the blocks above leave.
    lines(u32),
    /// What the fixed blocks leave, split evenly with every other sharing
    /// block.
    share,
  }

  record block {
    /// Identifies the block, so it keeps its scroll across `set-blocks`.
    id: u32,
    height: block-height,
    kind: block-kind,
  }

  /// What a pane did. Each names the id the consumer gave.
  variant pane-event {
    /// An action was pressed.
    pressed(u32),
    /// A toggle was pressed, asking for this state.
    toggled(tuple<u32, bool>),
    /// A slider was pressed or dragged to this fraction.
    slid(tuple<u32, f32>),
    /// A number was dragged sideways by this much of its value since the
    /// last report.
    scrubbed(tuple<u32, f32>),
    /// The drag on a slider or a number ended: the place to keep the value.
    released(u32),
    /// An option of a choice was pressed: the control id and the option's
    /// index.
    chosen(tuple<u32, u32>),
    /// A table row or a tree node was pressed.
    selected(u32),
    /// A tree node's fold mark was pressed, asking for this state.
    folded(tuple<u32, bool>),
    /// A link was pressed.
    followed(u32),
  }

  /// A framed page of blocks, for what is read and edited rather than held:
  /// values, lists, trees, tables and text. Laid out in the pane's own
  /// columns and lines, so nothing on it waits on the host to be measured.
  /// Read and worked with any pointer; a long block scrolls with the wheel
  /// or by dragging the rail at its edge, and Tab, Enter and Escape work the
  /// controls of the pane last pressed.
  ///
  /// Nothing shows until it is mounted and shown.
  resource pane {
    /// `columns` is one of 24, 40, 64 or 80. `lines` is the body's height
    /// from 1 to 40, or none to grow to fit its blocks. Anything else is
    /// `invalid-argument`.
    constructor(columns: u32, lines: option<u32>) -> result<pane, error>;
    /// At most 1024 bytes. Empty draws no title strip.
    set-title: func(title: string) -> result<_, error>;
    /// One small line at the bottom, for counts and state, at most 1024
    /// bytes.
    set-status: func(status: option<string>) -> result<_, error>;
    /// Stacks `blocks` down the body, at most 8. A string or a block over its
    /// limit is `invalid-argument` and the previous blocks are kept. Setting
    /// equal blocks writes nothing.
    set-blocks: func(blocks: list<block>) -> result<_, error>;
    /// The pane, width by height in metres.
    size: func() -> vec2;
    /// Everything it did since the last call.
    events: func() -> list<pane-event>;
    /// Eases it in or out.
    set-shown: func(value: bool);
    /// Stands it with its bottom centre on `at`, in the calling script's
    /// document frame, turned about the vertical axis to face the viewer.
    ///
    /// A standing pane is laid out larger than a floating one, since it labels
    /// something in the room and is read from further away. `size` answers
    /// for the mount the pane has, so mount it before reading its size.
    set-standing: func(at: vec3);
    /// A line from the pane's side nearer `to`, at the pane's vertical
    /// middle, to `to`, ending in a small dot there; none draws no line. In
    /// the calling script's document frame, for a standing or a floating
    /// pane.
    set-tether: func(to: option<vec3>);
    /// The colour of the tether line, or none for the neutral one.
    set-hue: func(hue: option<color>);
    /// Floats it centred on `at`, in the calling script's document frame. A
    /// grip picks it up and carries it like any body, and let go it drifts to
    /// a stop, floats there and turns to face the viewer.
    set-floating: func(at: vec3);
    /// Where a floating pane's centre is now: where it was put, or where it
    /// floats. Zero before it is shown.
    position: func() -> vec3;
    /// Fixes it at `pose` in the frame of `to`, a prim of the calling
    /// script's document, or in the document's own frame on none: on a wall,
    /// a machine or a frame. It is exactly where it is told and never eases,
    /// at the size of a floating pane. Nothing shows if `to` is not in the
    /// document.
    ///
    /// A pane that hangs is not carried by a grip. A station answers a grip
    /// by pulling the pane out of it.
    set-hung: func(to: option<prim-id>, pose: transform);
    /// Holds it in `hand`, at the distance a pane is read from: on the line
    /// from the eye to the hand, turned to face the eye, at the size of a
    /// floating pane. Nothing shows while the hand is not tracked.
    set-held: func(hand: hand);
  }

  /// Which hand.
  enum hand {
    left,
    right,
  }

  /// Which way a split lays its parts.
  enum axis {
    /// Side by side, left to right.
    across,
    /// Stacked, top to bottom.
    down,
  }

  /// One part of a split: a tile of the station, by its index, and how much
  /// of the split it takes against its siblings.
  record part {
    tile:   u32,
    /// At least 1.
    weight: u32,
  }

  /// A tile of a station: a leaf of panes, or a split of other tiles.
  variant tile {
    /// Panes as tabs of one leaf, by their index in the station's `panes`.
    /// The first is shown, and one dropped on the leaf takes its place.
    tabs(list<u32>),
    split(split),
  }

  record split {
    axis:  axis,
    /// At least one, each a different tile.
    parts: list<part>,
  }

  /// Panes arranged together, which open and close together. They stand on
  /// an arc around where the station was summoned, at reading distance and
  /// facing the middle of it: a pane at the left of the tiling stands to the
  /// left, one at the bottom stands lower.
  ///
  /// A grip on a pane of a shown station pulls it out. It floats, carried by
  /// that hand, leaving its place empty. Let go within reach of the station
  /// it goes to the nearest place, becoming the pane shown there and tabbing
  /// whatever was; let go further off it stays where it was left, and can be
  /// pulled again.
  ///
  /// The station owns where its panes are and whether they show, so a script
  /// does not mount or show them itself. A freed pane leaves its station.
  resource station {
    /// `tiles[0]` is the root. Every tile but the root is the part of
    /// exactly one split, and every pane appears in one leaf at most. At
    /// most 16 panes and 64 tiles; anything else is `invalid-argument`.
    constructor(panes: list<borrow<pane>>, tiles: list<tile>) -> result<station, error>;

    /// Puts it up where the viewer is standing now, facing as they face. A
    /// station measures its place once and keeps it until it is summoned
    /// again.
    summon: func() -> result<_, error>;
    /// Takes every pane down, including any pulled out.
    dismiss: func() -> result<_, error>;
    /// Whether it is up.
    shown: func() -> bool;
  }

  /// Reads input and resolves what it did, for every surface at once. Call
  /// from the script's `fixed-update`, where state belongs.
  fixed-update: func() -> result<_, error>;

  /// Steps and draws every surface. Call from the script's `update`, passing
  /// `tick.dt`, where animation belongs.
  update: func(dt: f32) -> result<_, error>;
}
