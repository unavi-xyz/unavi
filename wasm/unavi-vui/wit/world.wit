package unavi:vui;

world guest {
  include wired:prelude/lib-secure;
  export api;
}

/// Spatial UI, drawn into the calling script's own document and driven from
/// its update loop.
interface api {
  use wired:error/types.{error};
  use wired:math/types.{vec2, vec3};
  use wired:scene/types.{prim};

  /// What a mote is: how it draws, and what selecting it does.
  enum kind {
    /// Fires and is done — a pulse.
    action,
    /// Turns on, and off again when it is next chosen. Selecting one flips
    /// `active`, which it then holds and draws lit until something clears it.
    toggle,
    /// Can be pulled out and left in the room, or filed into a grid.
    item,
    /// Opens a cast site, which fills while it is held.
    cast,
    /// Opens into its children.
    group,
  }

  /// How a group's children are laid out when it opens. A grid and an orbit
  /// hold the same thing; this is the shape it takes, not a kind of mote.
  enum arrange {
    /// Around the parent, which stays in the middle.
    orbit,
    /// In rows, filling from the top left.
    grid,
  }

  /// A mote, and the level of children under it.
  ///
  /// A handle stays good after the mote is mounted, so a level edited while
  /// it is up redraws. A mote is the child of one level at a time: adding it
  /// somewhere else moves it.
  resource mote {
    constructor(kind: kind, label: string);

    /// Whether both handles name the same mote.
    is: func(other: borrow<mote>) -> bool;

    label: func() -> string;
    set-label: func(value: string);
    /// What it does, shown on its placard once attention has been held.
    describe: func(text: string);

    /// What this mote looks like, drawn inside its shell — a prim the
    /// consumer built, in the same document the surface draws into.
    ///
    /// Author it to fit a unit sphere: the surface parents it and scales it
    /// to whatever the mote is drawn at, so it grows with attention like the
    /// shell around it. An item holding an icon draws see-through so the icon
    /// reads; an item without one is solid.
    set-icon: func(value: option<borrow<prim>>);

    /// Whether this item stands for the one of its thing or for a source of
    /// them. Only an item is either; anything else ignores it.
    ///
    /// A unique item is *that* thing: placing it again is the same thing
    /// moving. A source is inexhaustible: every placing is another of it,
    /// with an identity of its own. Which one a mote is decides nothing about
    /// what lands — that is the consumer's, on `planted` — but it does decide
    /// how the mote reads, so the two never look alike.
    unique: func() -> bool;
    set-unique: func(value: bool);

    /// The shape this mote's own level takes when it opens. Groups default to
    /// an orbit; anything else ignores it.
    arrange: func() -> arrange;
    set-arrange: func(value: arrange);

    /// Whether a toggle is on. Anything else ignores it.
    ///
    /// Selecting a toggle flips this and reports `activated`, so a consumer
    /// reads it to find the new state. Writing it sets the mote up, or turns
    /// one off because another went on.
    active: func() -> bool;
    set-active: func(value: bool);

    parent: func() -> option<mote>;
    children: func() -> list<mote>;

    /// Takes `child` from whatever it was under and puts it here. Refused,
    /// and false, when `child` is already an ancestor — the only way a level
    /// could come to contain itself.
    add-child: func(child: borrow<mote>) -> bool;
    /// Takes `child` out of this level, doing nothing if it was never in it.
    remove-child: func(child: borrow<mote>);
    clear: func();
  }

  /// Which way a surface is measured off the viewer when it is placed.
  enum bearing {
    /// Ahead on the ground plane, standing upright however the viewer was
    /// looking. A surface you walk up to, and one that never ends up
    /// underfoot or overhead.
    level,
    /// Along the line of sight, turned to face the viewer. A surface summoned
    /// to where the eye already is, rather than one the eye has to find.
    sight,
  }

  /// Where a surface stands, measured from the viewer at the moment it first
  /// draws. It stays there afterwards: a menu that follows you around is a
  /// menu you cannot walk up to.
  record mount {
    /// Metres ahead of the viewer, along whichever direction `bearing` names.
    distance: f32,
    /// Metres above the eye, usually negative so a surface sits below it.
    height: f32,
    /// Sideways and vertical shift in the mounted frame, so surfaces sharing
    /// one facing do not sit on top of each other.
    offset: vec2,
    bearing: bearing,
  }

  /// Where a carried mote was let go, in the frame a document's offset is
  /// measured in, so placing one here needs no conversion.
  record landing {
    at: vec3,
    /// What the mote was carrying when it was released, for a consumer that
    /// wants the throw to land in what it places.
    velocity: vec3,
  }

  record page {
    index: u32,
    count: u32,
    /// Motes the level holds in all.
    total: u32,
  }

  /// What a surface did, in the terms a consumer thinks in.
  variant event {
    /// A container opened; the level inside it is drawn now.
    opened(mote),
    /// The way back was taken, to the level now open.
    closed(mote),
    /// A leaf fired.
    activated(mote),
    /// A cast site opened. Nothing has fired: holding attention on it fills
    /// it, and looking away aborts.
    casting(mote),
    /// A cast was held to the end.
    cast(mote),
    /// A cast was abandoned before it filled.
    aborted(mote),
    /// Carried out and let go in the room. The mote stays where it was and
    /// the surface draws nothing there: what lands, if anything, is the
    /// consumer's to place at the landing.
    planted(tuple<mote, landing>),
    /// Carried out and filed into a grid.
    filed(mote),
    /// The page turned.
    paged(page),
  }

  /// A level of motes arranged around an anchor, selected by direction.
  resource orbit {
    /// Puts one up over `root`, drawing `capacity` motes at once and paging
    /// anything past that.
    new: static func(root: borrow<mote>, mount: mount, capacity: u32) -> result<orbit, error>;

    /// Everything this orbit did since the last call.
    events: func() -> list<event>;

    /// Puts it up where the viewer is standing now. A surface measures its
    /// place once and keeps it, so this is how one comes to be somewhere
    /// else. Everything it draws is kept, so summoning again is cheap.
    summon: func() -> result<_, error>;
    /// Takes it down. Nothing it drew is thrown away, and its hit surface
    /// goes with it rather than staying as a wall you cannot see.
    dismiss: func() -> result<_, error>;
    /// Whether it is up.
    shown: func() -> bool;
  }

  /// A bounded grid of `root`'s motes, and a destination a release over it
  /// lands in: a mote filed here is taken out of the level it came from and
  /// hung under `root`.
  resource grid {
    new: static func(
      root: borrow<mote>,
      columns: u32,
      rows: u32,
      mount: mount,
    ) -> result<grid, error>;

    events: func() -> list<event>;

    summon: func() -> result<_, error>;
    dismiss: func() -> result<_, error>;
    shown: func() -> bool;
  }

  /// Reads input and resolves what it did, for every surface at once. Call
  /// from the script's `fixed-update`, where state belongs.
  fixed-update: func() -> result<_, error>;

  /// Steps and draws every surface. Call from the script's `update`, where
  /// animation belongs.
  update: func() -> result<_, error>;
}
