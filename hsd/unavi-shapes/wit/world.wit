package unavi:shapes;

/// Primitive mesh builders, composed into a consumer at build time.
///
/// Each resource holds its own tessellation parameters; `mesh` and
/// `collider` read them when called. `mesh` builds into the calling script's
/// own document unless `set-doc` names another one first. Tessellation
/// counts are clamped at the bounds documented on each setter, returning
/// `invalid-argument` over the limit.
world guest {
  include wired:prelude/imports;
  export api;
}

interface api {
  use wired:core/math.{vec3};
  use wired:core/error.{error};
  use wired:scene/properties.{collider};
  use wired:scene/document.{document, prim-id};

  resource capsule {
    constructor(radius: f32, height: f32);

    collider: func() -> collider;
    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);

    rings: func() -> u32;
    /// At most 32.
    set-rings: func(value: u32) -> result<_, error>;

    latitudes: func() -> u32;
    /// At most 64.
    set-latitudes: func(value: u32) -> result<_, error>;

    longitudes: func() -> u32;
    /// At most 128.
    set-longitudes: func(value: u32) -> result<_, error>;
  }

  resource cone {
    constructor(radius: f32, height: f32);

    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);

    resolution: func() -> u32;
    /// At most 128.
    set-resolution: func(value: u32) -> result<_, error>;
  }

  resource cuboid {
    constructor(size: vec3);

    collider: func() -> collider;
    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);
  }

  resource cylinder {
    constructor(radius: f32, height: f32);

    collider: func() -> collider;
    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);

    resolution: func() -> u32;
    /// At most 128.
    set-resolution: func(value: u32) -> result<_, error>;

    segments: func() -> u32;
    /// At most 64.
    set-segments: func(value: u32) -> result<_, error>;
  }

  resource sphere {
    constructor(radius: f32);

    collider: func() -> collider;
    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);

    subdivisions: func() -> u32;
    /// At most 6: `20 * 4^subdivisions` triangles, already 81,920 at the
    /// limit.
    set-subdivisions: func(value: u32) -> result<_, error>;
  }

  resource torus {
    constructor(minor-radius: f32, major-radius: f32);

    mesh: func() -> result<prim-id, error>;

    set-doc: func(doc: document);

    minor-resolution: func() -> u32;
    /// At most 64.
    set-minor-resolution: func(value: u32) -> result<_, error>;

    major-resolution: func() -> u32;
    /// At most 128.
    set-major-resolution: func(value: u32) -> result<_, error>;
  }
}
