package unavi:tool@0.1.0;

world guest {
  include wired:prelude/imports@0.1.0;
  export api;
}

/// A shell-hosted tool, built by a tool crate.
interface api {
  use wired:core/math@0.1.0.{color};
  use wired:core/ids@0.1.0.{document-id};
  use wired:core/error@0.1.0.{error};

  /// Visual state the shell pushes onto a tool.
  record tool-state {
    color: color,
  }

  variant tool-event {
    activate,
    deactivate,
    set-state(tool-state),
    /// Primary action forwarded by the shell while its menu is down.
    trigger(bool),
    /// Signed scroll notches (+ in, - out).
    scroll(f32),
  }

  resource tool {
    /// `name` and `description` are shown by the shell. `name` is at most 48
    /// bytes, `description` at most 256; over either is `invalid-argument`.
    constructor(name: string, description: string) -> result<tool, error>;
    poll: func() -> option<tool-event>;
  }

  record registered-tool {
    document:    document-id,
    name:        string,
    description: string,
  }

  /// Registry the shell pushes tools into, polled every frame.
  resource tool-registry {
    constructor();
    poll: func() -> list<registered-tool>;
    activate: func(document: document-id);
    deactivate: func(document: document-id);
    set-state: func(document: document-id, state: tool-state);
    trigger: func(document: document-id, pressed: bool);
    scroll: func(document: document-id, delta: f32);
  }
}
