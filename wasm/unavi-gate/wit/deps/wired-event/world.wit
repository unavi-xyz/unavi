package wired:event;

interface types {
  use wired:scene/types.{node, document-id};

  type event-channel = string;

  variant event-scope {
    global,
    /// Radius of spatial event
    spatial(f32), 
  }

  record event-filter {
    node:      option<node>,
    scope:     event-scope,
    documents: option<list<document-id>>,
  }

  variant event-sender {
    global,
    spatial,
  }

  record event {
    channel:         event-channel,
    payload:         list<u8>,
    sender:          event-sender,
    sender-document: document-id,
    time:            u64,
  }

  resource event-receptor {
    poll: func() -> option<event>;
  }
}

interface api {
  use types.{event-channel, event-filter, event-receptor};

  emit: func(channel: event-channel, payload: list<u8>, filter: event-filter);
  listen: func(channels: list<event-channel>, filter: event-filter) -> event-receptor;
}

world prelude {
  import api;
  import types;
}
