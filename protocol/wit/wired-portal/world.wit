/// Portals between spaces, and travel through them.
///
/// A two-way portal is two halves, one in each space, bearing the same
/// link. Opening one half asks the scripts of the target space for the other:
/// they hear a `link-intent` and answer it with `pair`.
package wired:portal;

interface portals {
  use wired:core/ids.{document-id, prim-id};
  use wired:core/error.{error};
  use wired:scene/document.{document};
  use wired:scene/properties.{link-id};

  /// A portal in `source-space` bearing `link` that nothing in this space
  /// answers yet.
  record link-intent {
    source-space: document-id,
    link:         link-id,
  }

  /// Points the portal on `prim` into `target-space` for this session,
  /// keeping its size, as a `shared` write. Fails with `invalid-argument`
  /// on a prim with no portal.
  ///
  /// The link is derived from the prim and the target, so every peer
  /// opening the same portal states the same one.
  open: func(document: borrow<document>, prim: prim-id, target-space: document-id) -> result<_, error>;

  /// Answers `intent` with the portal on `prim`, as a `shared` write.
  pair: func(document: borrow<document>, prim: prim-id, intent: link-intent) -> result<_, error>;

  /// Drops this peer's own session destination on the portal of `prim`, so
  /// the layers beneath show through. Closing a portal this peer never
  /// opened changes nothing it shows. Never takes quota.
  close: func(document: borrow<document>, prim: prim-id) -> result<_, error>;

  /// How a portal's destination resolved this frame.
  enum link-status {
    /// It leads nowhere.
    none,
    /// It leads into a space with no link, so there is no way back.
    one-way,
    /// It bears a link, and its destination has not resolved yet.
    pending,
    /// It bears a link, and the destination space holds no portal answering
    /// it.
    unpaired,
    /// It is glued to the portal answering its link.
    paired,
  }

  /// How the portal on `prim` resolved this frame. Fails with `not-ready`
  /// while the prim has no placed portal.
  link-state: func(document: borrow<document>, prim: prim-id) -> result<link-status, error>;

  /// Moves the local user into `target-space`, loading it if needed.
  travel: func(target-space: document-id) -> result<_, error>;

  /// The space the local user is in now, `none` while they are between
  /// spaces, such as mid-travel.
  current-space: func() -> result<option<document-id>, error>;

  /// Hears intents addressed to the script's space, each once.
  intents: func() -> result<intent-subscription, error>;

  /// Holds up to 64 intents.
  resource intent-subscription {
    drain:   func(max: u32) -> list<link-intent>;
    dropped: func() -> u64;
    /// Takes `intent` for this script, answering whether it won. Exactly one
    /// subscriber in the space does.
    claim:   func(intent: link-intent) -> bool;
  }
}
