package wired:error;

world all {
  import types;
}

interface types {
  /// Shared error surfaced by fallible host APIs.
  variant error {
    /// Catch-all for failures that do not fit the structured variants below.
    other(string),
    /// A rate limit was hit and waiting did not clear it in time. The bucket
    /// refills on its own, so retrying later may succeed.
    quota-flow,
    /// A ceiling on a resource held while live was hit. It frees only when
    /// something else releases, so retrying without freeing will not help.
    quota-stock,
    /// The script's document lacks the API permission for this call.
    permission,
    /// The target document does not accept writes from the caller's owner, or
    /// the two documents are not in the same space.
    reach,
  }
}
