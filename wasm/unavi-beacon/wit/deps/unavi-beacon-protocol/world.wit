package unavi:beacon-protocol;

world guest {
  include wired:prelude/lib;
  export api;
}

interface api {
  use wired:scene/types.{node};

  /// Emits this beacon's ID on the beacon channel.
  resource beacon-emitter {
    constructor(id: list<u8>, emitter: node, radius: f32);
    emit: func();
  }

  /// Listens for incoming beacon ID emissions.
  resource beacon-receptor {
    constructor(receptor: node, radius: f32);
    poll: func() -> option<list<u8>>;
  }
}
