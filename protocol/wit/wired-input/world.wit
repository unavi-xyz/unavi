/// Pointer input from the local user: aimed at prims, or for the whole
/// device.
///
/// A pointer is the screen cursor on desktop, or a hand in VR. Its trigger
/// acts on what it points at. Its grip takes hold of it.
package wired:input;

interface types {
  use wired:core/math.{vec2, vec3, ray, transform};
  use wired:core/ids.{prim-ref};

  enum pointer-kind {
    /// The desktop cursor, aimed from the camera.
    screen,
    left-hand,
    right-hand,
  }

  enum button {
    trigger,
    grip,
    menu,
  }

  /// Where a pointer's ray met a collider, in the calling script's own
  /// document frame.
  record hit {
    /// The prim whose collider it met, when it belongs to a document.
    target:   option<prim-ref>,
    position: vec3,
    normal:   vec3,
    distance: f32,
  }

  /// A physical key, named for its place on a US layout whatever the layout
  /// prints on it. Characters typed are not keys.
  enum key {
    a, b, c, d, e, f, g, h, i, j, k, l, m,
    n, o, p, q, r, s, t, u, v, w, x, y, z,
    digit0, digit1, digit2, digit3, digit4,
    digit5, digit6, digit7, digit8, digit9,
    f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12,
    space, enter, escape, tab, backspace, delete, insert,
    home, end, page-up, page-down,
    arrow-up, arrow-down, arrow-left, arrow-right,
    shift-left, shift-right, control-left, control-right,
    alt-left, alt-right, super-left, super-right,
    minus, equal, bracket-left, bracket-right, backslash,
    semicolon, quote, backquote, comma, period, slash,
  }

  /// What reaches which listener:
  ///
  /// | action               | targeted | device |
  /// |----------------------|----------|--------|
  /// | trigger, grip        | yes      | yes    |
  /// | menu                 | no       | yes    |
  /// | scroll               | yes      | yes    |
  /// | entered, left        | yes      | no     |
  /// | key                  | no       | yes    |
  variant action {
    pressed(button),
    /// A targeted listener hears the release of every press it heard,
    /// wherever the pointer has since moved.
    released(button),
    /// Notches turned on each axis.
    scroll(vec2),
    entered,
    left,
    /// A key went down. A held key does not repeat. The event carries the
    /// screen pointer's ray and no hit.
    key-pressed(key),
    key-released(key),
  }

  /// The ray and hit are in the calling script's own document frame.
  record input-event {
    pointer: pointer-kind,
    action:  action,
    ray:     ray,
    hit:     option<hit>,
  }

  /// A pointer's state this frame. The ray and hit are in the calling
  /// script's own document frame.
  record pointer {
    kind:    pointer-kind,
    /// Whether it is tracked and usable this frame. An inactive pointer's
    /// other fields are zero.
    active:  bool,
    /// Where it is and which way it faces, roll included. The ray starts at
    /// its translation and runs along its forward.
    pose:    transform,
    ray:     ray,
    /// How far the trigger is pulled, 0 to 1.
    trigger: f32,
    /// How far the hand is closed, 0 to 1.
    grip:    f32,
    /// Thumbstick travel, each axis -1 to 1.
    axis:    vec2,
    hit:     option<hit>,
  }

  /// Holds up to 64 events.
  resource input-subscription {
    drain:   func(max: u32) -> list<input-event>;
    dropped: func() -> u64;
  }
}

/// Input aimed at a prim.
interface targeted {
  use wired:core/ids.{prim-id};
  use wired:core/error.{error};
  use wired:scene/document.{document};
  use types.{input-subscription};

  /// Input aimed at `prim` or anything beneath it, in a document the script
  /// may write. Only prims with a collider can be aimed at.
  listen: func(document: borrow<document>, prim: prim-id) -> result<input-subscription, error>;
}

/// Every input of the local user's devices.
interface device {
  use wired:core/error.{error};
  use types.{input-subscription, pointer, pointer-kind};

  /// A control the host acts on by itself.
  enum control {
    /// Squeezing picks up what the pointer is on.
    grip,
    /// A hand's stick moves or turns the user.
    stick,
  }

  /// One pointer's control, taken from the host while this is held. The
  /// host does not act on a claimed control; listeners and `pointers` still
  /// report it. Dropping the claim hands the control back, once every claim
  /// on it is dropped.
  resource claim;

  listen:   func() -> result<input-subscription, error>;
  /// Every pointer kind, active or not.
  pointers: func() -> result<list<pointer>, error>;
  /// Takes `control` of `pointer` from the host until the claim is dropped.
  take-control: func(pointer: pointer-kind, control: control) -> result<claim, error>;
}
