package unavi:tool;

world guest {
  include wired:prelude/imports;
  export api;
}

/// A shell-hosted tool, built by a tool crate.
interface api {
  use wired:core/math.{color};
  use wired:core/ids.{document-id};
  use wired:core/error.{error};
  use wired:input/types.{pointer-kind};

  /// Visual state the shell pushes onto a tool.
  record tool-state {
    color: color,
  }

  /// A button the shell forwards to the tool in hand, while its menu is down.
  enum tool-button {
    /// The tool hand's trigger. Desktop: the left mouse button.
    primary,
    /// The tool hand's grip, squeezed on nothing the hand can pick up.
    /// The grip is the hand's first, so a squeeze on something grabbable
    /// picks it up instead, unless the tool holds the grip (`hold-grip`).
    /// Desktop: the right mouse button.
    secondary,
    /// The other hand's trigger. Desktop: either Shift.
    modifier,
  }

  variant tool-event {
    /// The tool is in hand. It aims with this pointer: the screen pointer on
    /// desktop, the hand that took it in VR. Its stick is read from the
    /// pointer itself.
    activate(pointer-kind),
    deactivate,
    set-state(tool-state),
    pressed(tool-button),
    released(tool-button),
    /// Signed scroll notches (+ in, - out).
    scroll(f32),
  }

  /// A square grid of dots a shell may draw as the tool's mark. It has the
  /// shape of `unavi:vui`'s glyph, declared again here because this package
  /// does not import that one: a tool has no business depending on the shell's
  /// drawing library just to say what it looks like.
  record glyph {
    /// Cells along each side, from 1 to 13.
    size: u8,
    /// Row-major from the top-left, cell `i` being bit `i % 8` (least
    /// significant first) of byte `i / 8`. At least `ceil(size * size / 8)`
    /// bytes; bytes past that are ignored.
    bits: list<u8>,
  }

  resource tool {
    /// `name` and `description` are shown by the shell. `name` is at most 48
    /// bytes, `description` at most 256; over either is `invalid-argument`.
    /// So is a `glyph` whose `size` is outside 1 to 13 or whose `bits` are
    /// shorter than its grid needs. A tool with no glyph is drawn with a
    /// generic one.
    constructor(name: string, description: string, glyph: option<glyph>) -> result<tool, error>;
    poll: func() -> option<tool-event>;
    /// While held, every squeeze of the tool hand's grip is the tool's
    /// `secondary`, and the hand picks nothing up with it: for a tool that has
    /// something in hand of its own, such as a body on a beam. Let go as soon
    /// as that ends. Putting the tool away lets go.
    hold-grip: func(held: bool);
  }

  record registered-tool {
    document:    document-id,
    name:        string,
    description: string,
    /// The tool's own mark, when it announced a valid one.
    glyph:       option<glyph>,
  }

  /// Registry the shell pushes tools into, polled every frame.
  resource tool-registry {
    constructor();
    poll: func() -> list<registered-tool>;
    activate: func(document: document-id, hand: pointer-kind);
    deactivate: func(document: document-id);
    /// Whether the tool holds its hand's grip, as of the last `poll`.
    holds-grip: func(document: document-id) -> bool;
    set-state: func(document: document-id, state: tool-state);
    press: func(document: document-id, button: tool-button, pressed: bool);
    scroll: func(document: document-id, delta: f32);
  }
}
