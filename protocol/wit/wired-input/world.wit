package wired:input;

world all {
  import api;
  import context;
  import types;
}

interface api {
  use types.{input-listener};
  use wired:scene/types.{prim};
  use wired:error/types.{error};

  /// Captures input aimed at a prim or anything under it.
  /// Requires a collider to function.
  ///
  /// A press is aimed and its release is not: whatever heard a button go
  /// down hears it come up, however far the pointer has travelled since and
  /// whatever it is over — including nothing, and including the case where
  /// the prim gave up its own collider in the meantime.
  register-input-listener: func(target: borrow<prim>) -> result<input-listener, error>;
}

interface context {
  use types.{input-listener, pointer};
  use wired:error/types.{error};

  /// Captures all input events from the local agent.
  register-global-input-listener: func() -> result<input-listener, error>;

  /// Where the local agent is pointing, this frame.
  pointers: func() -> result<list<pointer>, error>;
}

interface types {
  use wired:math/types.{vec2, vec3};

  enum pointer-kind {
    /// The desktop pointer, aimed by the head.
    screen,
    left-hand,
    right-hand,
  }

  record ray {
    origin: vec3,
    dir:    vec3,
  }

  /// Where a pointer's ray met the world.
  record hit {
    position: vec3,
    normal:   vec3,
    distance: f32,
  }

  record pointer {
    kind: pointer-kind,
    /// Whether the pointer is tracked and usable this frame.
    active: bool,
    ray:    ray,
    /// How hard the trigger is pulled, 0 to 1. Analogue where the binding
    /// is. Acting on whatever the ray is aimed at.
    trigger: f32,
    /// How hard the hand is closed, 0 to 1. Taking hold of whatever the ray
    /// is aimed at, which is never the same input as the trigger.
    grip: f32,
    /// Thumbstick travel; zero for a pointer with no stick.
    axis: vec2,
    hit:  option<hit>,
  }

  variant input-action {
    /// The trigger, the button everything picks with.
    press,
    /// Per-prim, this ends a `press` this prim heard and nothing else.
    release,
    /// The grip closing on this prim.
    grip-press,
    /// Per-prim, this ends a `grip-press` this prim heard and nothing else.
    grip-release,
    /// Notches turned, so ten is not one.
    scroll(vec2),
    /// Per-prim only: a global listener has no bounds to cross.
    enter,
    /// Per-prim only: a global listener has no bounds to cross.
    leave,
    /// Global only, and carrying the pointer whose hand pressed it.
    menu-press,
    /// Global only, and carrying the pointer whose hand pressed it.
    menu-release,
  }

  record input-event {
    pointer: pointer-kind,
    action:  input-action,
    ray:     ray,
    hit:     option<hit>,
  }

  resource input-listener {
    poll: func() -> option<input-event>;
  }
}
