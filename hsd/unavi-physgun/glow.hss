// Inverted-hull highlight for grabbed props (`cull: Front` draws only the
// extruded silhouette behind the prop).
(
    public_inputs: [
        Color((1.0, 0.62, 0.16, 1.0)), // 0: tint (overridden per player)
        Float(1.0),                    // 1: fresnel power
        Float(2.5),                    // 2: intensity
    ],
    surface: (
        nodes: [
            Fresnel(power: Input(1)),
            Saturate(x: Node(0)),
            Mul(a: Node(1), b: Input(2)),
            Mul(a: Input(0), b: Node(2)),

            // Zero alpha for premultiplied additive blending.
            Extract(v: Node(3), channel: 0),
            Extract(v: Node(3), channel: 1),
            Extract(v: Node(3), channel: 2),
            Combine4(x: Node(4), y: Node(5), z: Node(6), w: Const(Float(0.0))),
        ],
        output: Unlit((color: Node(7))),
        blend: Add,
        cull: Front,
        cast_shadows: false,
    ),
)
