package wired:portal;

world all {
  import api;
}

interface api {
  use wired:scene/types.{prim, document-id, link-id};
  use wired:error/types.{error};

  /// States a two-way destination into `target-space` on `prim` for this
  /// session, keeping the prim's portal size. Fails on a prim with no portal.
  ///
  /// The link is derived from the prim and target, so every peer opening the
  /// same portal to the same space states the same link. Scripts in the target
  /// space hear a `link-intent` on `unavi:portal:intent` until one answers it
  /// with `pair`.
  open: func(prim: prim, target-space: document-id) -> result<_, error>;

  /// Answers a link intent: states a destination into `source-space` under
  /// `link` on `prim` for this session, keeping the prim's portal size. Fails
  /// on a prim with no portal.
  pair: func(prim: prim, source-space: document-id, link: link-id) -> result<_, error>;

  /// Teleport the local agent into `target-space`, loading it if needed.
  travel: func(target-space: document-id) -> result<_, error>;
}
