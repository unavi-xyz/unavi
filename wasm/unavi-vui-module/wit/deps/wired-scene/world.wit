package wired:scene;

world prelude {
  import context;
  import types;
}

interface context {
  use types.{document, node, document-id};

  // The node this script is attached to.
  self-node: func() -> node;
  // The document this script's node belongs to.
  self-document: func() -> document;
  // Get another document by ID. Returns none if the document does not exist
  // or this script lacks read permission.
  get-document: func(id: document-id) -> option<document>;
  // Create a new HSD document owned by this script's document.
  // Requires the create-document permission. Returns an error on failure.
  create-document: func() -> result<document, string>;
  // Destroy a previously created document. No-op if not found or no write access.
  remove-document: func(id: document-id);
}

interface types {
  use wired:math/types.{vec3, quat, transform};

  type document-id = list<u8>;

  resource document {
    id: func() -> list<u8>;
    clone: func() -> document;

    roots: func() -> list<node>;
    nodes: func() -> list<node>;
    meshes: func() -> list<mesh>;
    materials: func() -> list<material>;

    create-node: func() -> node;
    create-mesh: func() -> mesh;
    create-material: func() -> material;

    remove-node: func(value: borrow<node>);
    remove-mesh: func(value: borrow<mesh>);
    remove-material: func(value: borrow<material>);

    sync: func() -> bool;
    set-sync: func(value: bool);

    // Whether this document is publicly readable on the network.
    public: func() -> bool;
    // Mark this document public or private. Syncs to the WDS ACL.
    set-public: func(value: bool);
  }

  resource node {
    id: func() -> string;
    clone: func() -> node;

    name: func() -> option<string>;
    set-name: func(value: option<string>);

    translation: func() -> vec3;
    set-translation: func(value: vec3);

    rotation: func() -> quat;
    set-rotation: func(value: quat);

    scale: func() -> vec3;
    set-scale: func(value: vec3);

    transform: func() -> transform;
    set-transform: func(value: transform);

    global-transform: func() -> transform;

    parent: func() -> option<node>;
    children: func() -> list<node>;
    add-child: func(child: borrow<node>);
    remove-child: func(child: borrow<node>);

    mesh: func() -> option<mesh>;
    set-mesh: func(value: option<borrow<mesh>>);

    material: func() -> option<material>;
    set-material: func(value: option<borrow<material>>);

    collider: func() -> option<collider>;
    set-collider: func(value: option<collider>);

    rigid-body: func() -> option<rigid-body-kind>;
    set-rigid-body: func(value: option<rigid-body-kind>);

    sync: func() -> bool;
    set-sync: func(value: bool);
  }

  record color {
    r: f32,
    g: f32,
    b: f32,
    a: f32,
  }

  enum alpha-mode {
    add,
    blend,
    mask,
    multiply,
    opaque,
    pre-multiplied,
  }

  resource material {
    id: func() -> string;
    clone: func() -> material;

    name: func() -> option<string>;
    set-name: func(value: option<string>);

    alpha-cutoff: func() -> f32;
    set-alpha-cutoff: func(value: f32);

    alpha-mode: func() -> option<alpha-mode>;
    set-alpha-mode: func(value: option<alpha-mode>);

    base-color: func() -> color;
    set-base-color: func(value: color);

    metallic: func() -> f32;
    set-metallic: func(value: f32);

    roughness: func() -> f32;
    set-roughness: func(value: f32);

    double-sided: func() -> bool;
    set-double-sided: func(value: bool);

    unlit: func() -> bool;
    set-unlit: func(value: bool);

    sync: func() -> bool;
    set-sync: func(value: bool);
  }

  enum primitive-topology {
    point-list,
    line-list,
    line-strip,
    triangle-list,
    triangle-strip,
  }

  variant indices {
    half(list<u16>),
    full(list<u32>),
  }

  resource mesh {
    id: func() -> string;
    clone: func() -> mesh;

    name: func() -> option<string>;
    set-name: func(value: option<string>);

    topology: func() -> primitive-topology;
    set-topology: func(value: primitive-topology);

    indices: func() -> option<indices>;
    set-indices: func(value: option<indices>);

    positions: func() -> option<list<f32>>;
    set-positions: func(values: option<list<f32>>);

    normals: func() -> option<list<f32>>;
    set-normals: func(values: option<list<f32>>);

    tangents: func() -> option<list<f32>>;
    set-tangents: func(values: option<list<f32>>);

    colors: func() -> option<list<f32>>;
    set-colors: func(values: option<list<f32>>);

    uv0: func() -> option<list<f32>>;
    set-uv0: func(values: option<list<f32>>);

    uv1: func() -> option<list<f32>>;
    set-uv1: func(values: option<list<f32>>);

    sync: func() -> bool;
    set-sync: func(value: bool);
  }

  variant collider {
    capsule(collider-capsule),
    convex-hull(list<f32>),
    cuboid(vec3),
    cylinder(collider-cylinder),
    sphere(f32),
    trimesh(collider-trimesh),
  }

  record collider-capsule {
    height: f32,
    radius: f32,
  }

  record collider-cylinder {
    height: f32,
    radius: f32,
  }

  record collider-trimesh {
    indices: list<u32>,
    vertices: list<f32>,
  }

  enum rigid-body-kind {
    dynamic,
    fixed,
    kinematic,
  }
}
