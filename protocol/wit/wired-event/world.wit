package wired:event;

world all {
  import api;
  import types;
}

interface api {
  use types.{event-filter, event-receptor};

  emit: func(channel: string, payload: list<u8>, filter: event-filter);
  listen: func(channels: list<string>, filter: event-filter) -> event-receptor;
}

interface types {
  use wired:scene/types.{prim, document-id};

  record spatial-scope {
    prim: prim,
    radius: f32,
  }

  variant event-scope {
    global,
    spatial(spatial-scope),
  }

  record event-filter {
    documents: option<list<document-id>>,
    scope: event-scope,
  }

  record spatial-sender {
    distance: f32,
    prim: prim,
  }

  variant sender-scope {
    global,
    spatial(spatial-sender),
  }

  record event-sender {
    document: list<u8>,
    scope: sender-scope,
  }

  record event {
    channel: string,
    payload: list<u8>,
    sender: event-sender,
    time: u64,
  }

  resource event-receptor {
    poll: func() -> option<event>;
  }
}
