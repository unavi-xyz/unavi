package wired:wds;

world all {
  import api;
  import types;
}

interface api {
  use types.{wds};
  use wired:error/types.{error};

  get-wds: func() -> result<wds, error>;
}

interface types {
  /// A doc identity: the 32-byte iroh-docs NamespaceId.
  type namespace = list<u8>;
  /// A content-addressed blob hash (32 bytes).
  type hash      = list<u8>;

  /// A single key -> value entry within a doc.
  record entry {
    key:   string,
    value: list<u8>,
  }

  resource get-future {
    poll: func() -> option<result<option<list<u8>>>>;
  }

  resource list-future {
    poll: func() -> option<result<list<entry>>>;
  }

  resource blob-future {
    poll: func() -> option<result<list<u8>>>;
  }

  /// Generic personal data store: key/value entries in docs (iroh-docs
  /// namespaces) plus content-addressed blobs.
  resource wds {
    /// Creates a new writable doc, returning its namespace.
    create-doc:  func() -> namespace;
    /// Writes a key -> value entry into a doc held with write capability.
    set:         func(ns: namespace, key: string, value: list<u8>);
    /// Removes a key from a doc held with write capability.
    delete:      func(ns: namespace, key: string);
    /// Reads the value at a key.
    get:         func(ns: namespace, key: string) -> get-future;
    /// Lists the latest entries whose key starts with `prefix`.
    %list:       func(ns: namespace, prefix: string) -> list-future;
    /// Fetches a content-addressed blob.
    get-blob:    func(blob-id: hash) -> blob-future;
    /// This DID's root doc namespace, if one is set.
    root-doc:    func() -> option<namespace>;
    /// The view docs of the registries this client follows, kept synced
    /// locally; entry keys are rank-ordered. Views are distinguished by key
    /// prefix; `live/<space>` names a space with current occupants.
    registries:  func() -> list<namespace>;
  }
}
