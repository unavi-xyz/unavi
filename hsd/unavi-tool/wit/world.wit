package unavi:tool;

world guest {
  include wired:prelude/imports;
  export api;
}

/// A shell-hosted tool, built by a tool crate.
interface api {
  use wired:core/math.{color};
  use wired:core/ids.{document-id};
  use wired:core/error.{error};

  /// Visual state the shell pushes onto a tool.
  record tool-state {
    color: color,
  }

  variant tool-event {
    activate,
    deactivate,
    set-state(tool-state),
    /// Primary action forwarded by the shell while its menu is down.
    trigger(bool),
    /// Signed scroll notches (+ in, - out).
    scroll(f32),
  }

  /// A square grid of dots a shell may draw as the tool's mark. It has the
  /// shape of `unavi:vui`'s glyph, declared again here because this package
  /// does not import that one: a tool has no business depending on the shell's
  /// drawing library just to say what it looks like.
  record glyph {
    /// Cells along each side, from 1 to 13.
    size: u8,
    /// Row-major from the top-left, cell `i` being bit `i % 8` (least
    /// significant first) of byte `i / 8`. At least `ceil(size * size / 8)`
    /// bytes; bytes past that are ignored.
    bits: list<u8>,
  }

  resource tool {
    /// `name` and `description` are shown by the shell. `name` is at most 48
    /// bytes, `description` at most 256; over either is `invalid-argument`.
    /// So is a `glyph` whose `size` is outside 1 to 13 or whose `bits` are
    /// shorter than its grid needs. A tool with no glyph is drawn with a
    /// generic one.
    constructor(name: string, description: string, glyph: option<glyph>) -> result<tool, error>;
    poll: func() -> option<tool-event>;
  }

  record registered-tool {
    document:    document-id,
    name:        string,
    description: string,
    /// The tool's own mark, when it announced a valid one.
    glyph:       option<glyph>,
  }

  /// Registry the shell pushes tools into, polled every frame.
  resource tool-registry {
    constructor();
    poll: func() -> list<registered-tool>;
    activate: func(document: document-id);
    deactivate: func(document: document-id);
    set-state: func(document: document-id, state: tool-state);
    trigger: func(document: document-id, pressed: bool);
    scroll: func(document: document-id, delta: f32);
  }
}
